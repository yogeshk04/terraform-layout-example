# Local .terraform directories (provider binaries, modules cache)
**/.terraform/*

# NOTE: .terraform.lock.hcl IS committed on purpose so provider versions
# are reproducible across the team and CI. Do not add it here.

# State files (never commit)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Real tfvars (only commit the .example templates)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output
*tfplan*

# CLI config / creds
.terraformrc
terraform.rc

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
